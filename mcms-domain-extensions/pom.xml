<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mcms</groupId>
        <artifactId>mcms-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcms-domain-extensions</artifactId>
    <packaging>jar</packaging>

    <name>MCMS Domain Extensions</name>
    <description>DSL-generated enhancements (State Machines, Events, Validators)</description>

    <dependencies>
        <!-- MCMS Code Generator (for running generation during build) -->
        <dependency>
            <groupId>com.mcms</groupId>
            <artifactId>mcms-codegen</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- MCMS DSL (for DSL file access during generation) -->
        <dependency>
            <groupId>com.mcms</groupId>
            <artifactId>mcms-dsl</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Run MCMS Code Generator during generate-sources phase -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-state-machines</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.mcms.codegen.McmsCodeGenerator</mainClass>
                            <arguments>
                                <argument>${project.basedir}/../mcms-dsl/src/main/resources/mcms-states.dsl</argument>
                                <argument>${project.basedir}/target/generated-sources/mcms</argument>
                                <argument>${project.basedir}/target/generated-test-sources/mcms</argument>
                            </arguments>
                            <classpathScope>provided</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build Helper - Add Generated Sources -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/target/generated-sources/mcms</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/target/generated-test-sources/mcms</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Note: Generated code appears in target/generated-sources/mcms -->
    <!-- Generated by mcms-codegen module's McmsCodeGenerator -->
    <!-- Stub entity classes (Batch, PhaseName) are in src/main/java for compilation -->

</project>
