        <addForeignKeyConstraint baseColumnNames="batch_id"
                                 baseTableName="supply_order_line"
                                 constraintName="fk_supply_order_line__batch_id"
                                 referencedColumnNames="id"
                                 referencedTableName="batch"
                                 />
    </changeSet>
</databaseChangeLog>
