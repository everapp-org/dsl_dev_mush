    <!--
        Added the constraints for entity SupplyOrderLine.
    -->
    <changeSet id="20260222143025-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="supply_order_id"
                                 baseTableName="supply_order_line"
                                 constraintName="fk_supply_order_line__supply_order_id"
                                 referencedColumnNames="id"
