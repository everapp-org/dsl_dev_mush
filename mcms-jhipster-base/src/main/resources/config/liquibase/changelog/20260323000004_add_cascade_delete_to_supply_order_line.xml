<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Add CASCADE DELETE to supply_order_line relationship.
        When a supply_order is deleted, all related supply_order_line entries should be deleted.
    -->
    <changeSet id="20260323000004-1" author="claude">

        <!-- Supply Order Line: Drop existing FK, recreate with CASCADE -->
        <dropForeignKeyConstraint baseTableName="supply_order_line" constraintName="fk_supply_order_line__supply_order_id"/>
        <addForeignKeyConstraint baseColumnNames="supply_order_id"
                                 baseTableName="supply_order_line"
                                 constraintName="fk_supply_order_line__supply_order_id"
                                 referencedColumnNames="id"
                                 referencedTableName="supply_order"
                                 onDelete="CASCADE"/>

    </changeSet>
</databaseChangeLog>
